{
  "name": "satish-talk",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "convex:dev": "convex dev",
    "typecheck": "tsc -b --noEmit && tsc -p convex/tsconfig.json --noEmit",
    "e2e": "playwright test",
    "test": "vitest run",
    "lint": "eslint src convex --max-warnings 0"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.2.8",
    "convex": "^1.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "^1.61.1",
    "typescript": "^5.7.0",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "convex-test": "^0.0.38",
    "eslint": "^9.39.5",
    "typescript-eslint": "^8.72.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "@testing-library/react": "^16.3.0",
    "jsdom": "^26.1.0",
    "@playwright/test": "^1.61.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
